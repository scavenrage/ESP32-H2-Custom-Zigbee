# ESP-IDF build output (regenerated by "idf.py build", not needed in the repo)
firmware/build/

# ESP-IDF Component Manager cache (re-downloaded automatically from idf_component.yml)
firmware/managed_components/
firmware/dependencies.lock

# Generated local config (machine/session-specific, regenerated from sdkconfig.defaults)
firmware/sdkconfig
firmware/sdkconfig.old

# Editor/IDE
.vscode/
.idea/
.claude/

# OS junk
.DS_Store
Thumbs.db

# Development notes / AI session transcripts (private)
chat-claude-code/

# Local working files (serial logs, flash dumps, generated per-device config, local flashing kit)
tools/logs/
tools/kit_programmazione/
*_dump*.bin
nvs_dump*.bin
nvs_config.bin
nvs_config.csv
