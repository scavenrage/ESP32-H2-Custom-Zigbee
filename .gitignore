firmware/build/

# ESP-IDF Component Manager cache (re-downloaded automatically from idf_component.yml)
firmware/managed_components/
firmware/dependencies.lock

# Generated local config (machine/session-specific, regenerated from sdkconfig.defaults)
firmware/sdkconfig
firmware/sdkconfig.old

# Editor/IDE
.vscode/
.idea/
.claude/

# OS junk
.DS_Store
Thumbs.db
