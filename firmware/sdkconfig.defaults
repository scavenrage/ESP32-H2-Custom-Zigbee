#
# Flash size — ESP32-H2-MINI ha 4MB
#
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

#
# mbedTLS — richiesto dal layer di sicurezza Zigbee
#
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_MBEDTLS_HARDWARE_SHA=n
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y

#
# Zboss — ZCZR abilita sia Coordinator che Router (ruolo scelto a runtime)
#
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y

#
# Prestazioni radio e sistema
# IEEE802154_TIMING_OPTIMIZATION: migliora stabilità radio e throughput OTA
# FREERTOS_HZ=1000: migliora responsività task (default 100, consigliato 1000 da Espressif per Zigbee)
#
CONFIG_IEEE802154_TIMING_OPTIMIZATION=y
CONFIG_FREERTOS_HZ=1000

#
# Brownout detector — soglia minima (level 0, ~2.43V) per evitare false
# attivazioni da transienti rapidi sulla linea 230V (commutazione switch/fotoaccoppiatore).
# Il dispositivo è alimentato a 5V con LDO a 3.3V: un calo breve non compromette
# il funzionamento, ma triggera il brownout detector con la soglia di default.
#
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_0=y
CONFIG_ESP_BROWNOUT_DET_LVL=0

#
# CCA threshold (energia oltre cui il canale è considerato occupato).
# Default IDF 5.1.2 = -60 dBm, default IDF 5.5.x = -75 dBm: con soglia più bassa il radio
# differisce/perde più trasmissioni in presenza di rumore (transitori dei motori delle tapparelle).
# Esperimento: ripristinato il valore della build 5.1.2.
#
CONFIG_IEEE802154_CCA_THRESHOLD=-60

#
# BLE (NimBLE) solo per la modalità aggiornamento: ruolo peripheral, 1 connessione.
# Configurazione ripresa da sdkconfig.ci.peripheral dell'esempio bleprph.
#
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Throughput: MTU grande (esempio throughput_app di ESP-IDF usa 512) e qualche buffer in più
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=40
# Log NimBLE: solo warning/errori (a INFO stampa una riga per ogni notifica durante il trasferimento)
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

#
# Core dump: DISATTIVATO nella build per i dispositivi installati. Con il core dump su UART, dopo un panic
# il firmware stampa il dump sulla seriale anche senza cavo (2-3 s, molto di più con la memoria dati) prima
# di riavviarsi: inutile e pericoloso su una tapparella in movimento. Per il banco di prova attivare:
#   CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
# (opzionali: CONFIG_ESP_COREDUMP_CAPTURE_DRAM=y e CONFIG_ESP_COREDUMP_DECODE_DISABLE=y, vedi tools/serial_log.py)
#
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y

#
# Prova esp-zigbee-lib 2.x: livello di compatibilità con l'API 1.x (guida di migrazione Espressif, "Compatibility Layer").
# Non garantisce compatibilità ABI e non è pensato per la produzione: serve a valutare lo stack 2.x.
#
CONFIG_ZB_SDK_1xx=y
